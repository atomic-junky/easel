; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GestureApp"
config/version="0.0.2-alpha"
run/main_scene="res://scenes/app/app.tscn"
config/features=PackedStringArray("4.4")
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://b4pu8yxomwywq"
config/icon="uid://dtxlo5ebacbd0"

[autoload]

Constants="*res://autoloads/constants.gd"
App="*res://autoloads/app.gd"
SceneLoader="*res://autoloads/scene_loader/scene_loader.tscn"
PinterestFetcher="*res://autoloads/plugins/pinterest_fetcher.gd"
UrlImageLoader="*res://autoloads/plugins/url_image_loader.gd"

[display]

window/size/resizable=false
window/stretch/aspect="ignore"
window/handheld/orientation=1
window/size/width=600
window/size/height=1024

[editor_plugins]

enabled=PackedStringArray("res://addons/awaitable_http_request/plugin.cfg")

[gui]

theme/custom="uid://c4tjtr1l5tu78"
theme/custom_font="uid://cus4jsf1mbr0y"
theme/default_font_hinting=2
theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 1,
"editor/convert_colors_with_editor_theme": false,
"editor/scale_with_editor_scale": false,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": "",
"svg/scale": 2.0
}

[input]

app_undo={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
app_do={
